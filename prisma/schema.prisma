  signatureAssetId       String?        @unique
  logoAsset              InvoiceAsset? @relation("InvoiceBrandingLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  signatureAsset         InvoiceAsset? @relation("InvoiceBrandingSignature", fields: [signatureAssetId], references: [id], onDelete: SetNull)
  invoices               Invoice[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model InvoiceTemplate {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  notes              String?
  extractedText      String?
  detectedFieldsJson Json?
  extractionWarnings Json?
  assetId            String?         @unique
  asset              InvoiceAsset?  @relation("InvoiceTemplateAsset", fields: [assetId], references: [id], onDelete: SetNull)
  createdByUserId    String?
  createdByUser      User?          @relation("InvoiceTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([workspaceId, createdAt])
}

model InvoiceService {
  id                  String      @id @default(cuid())
  workspaceId         String
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceName         String
  description         String?
  defaultPriceCents   Int
  currency            String      @default("AUD")
  gstRateBps          Int         @default(1000)
  isTaxInclusive      Boolean     @default(false)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([workspaceId, active])
}

model Invoice {
  id                    String         @id @default(cuid())
  workspaceId           String
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matterId              String?
  matter                Matter?        @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdByUserId       String
  createdByUser         User           @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  templateId            String?
  template              InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  brandingId            String?
  branding              InvoiceBranding? @relation(fields: [brandingId], references: [id], onDelete: SetNull)
  clientName            String
  clientEmail           String?
  clientAddress         String?
  invoiceNumber         String
  issueDate             DateTime
  dueDate               DateTime
  currency              String        @default("AUD")
  subtotalCents         Int           @default(0)
  gstCents              Int           @default(0)
  discountCents         Int           @default(0)
  totalCents            Int           @default(0)
  lineItemsJson         Json
  notes                 String?
  paymentInstructions   String?
  generatedContent      String?
  aiReasoningJson       Json?
  accountingSyncJson    Json?
  reviewRequired        Boolean       @default(true)
  status                InvoiceStatus @default(DRAFT)
  sentAt                DateTime?
  paidAt                DateTime?
  cancelledAt           DateTime?
  paymentLinks          InvoicePaymentLink[]
  billingEvents         BillingEvent[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  assets                InvoiceAsset[] @relation("InvoiceAttachment")

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status, issueDate])
}

model InvoiceAsset {
  id                   String           @id @default(cuid())
  workspaceId          String
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandingLogoFor      InvoiceBranding? @relation("InvoiceBrandingLogo")
  brandingSignatureFor InvoiceBranding? @relation("InvoiceBrandingSignature")
  templateFor          InvoiceTemplate? @relation("InvoiceTemplateAsset")
  invoiceId            String?
  invoice              Invoice?         @relation("InvoiceAttachment", fields: [invoiceId], references: [id], onDelete: SetNull)
  kind                 InvoiceAssetKind
  fileName             String
  mimeType             String
  storageKey           String
  contentHash          String?
  fileSize             Int?
  extractedText        String?
  detectedFieldsJson   Json?
  data                 Bytes?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([workspaceId, kind])
}

model WorkspaceSubscription {
  id                     String                     @id @default(cuid())
  workspaceId            String
  workspace              Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?                    @unique
  plan                   BillingPlan
  status                 WorkspaceSubscriptionStatus
  billingEmail           String?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                    @default(false)
  providerMetadataJson   Json?
  lastSyncedAt           DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  billingEvents          BillingEvent[]

  @@index([workspaceId, status])
  @@index([provider, lastSyncedAt])
}

model BillingEvent {
  id                 String                 @id @default(cuid())
  workspaceId        String
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       WorkspaceSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId          String?
  invoice            Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider           String
  eventType          String
  providerEventId    String?                @unique
  status             String
  summary            String?
  payloadPreviewJson Json?
  createdAt          DateTime               @default(now())

  @@index([workspaceId, createdAt])
  @@index([provider, eventType, createdAt])
}

model InvoicePaymentLink {
  id                  String               @id @default(cuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId           String
  invoice             Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider            String
  stripePaymentLinkId String?              @unique
  checkoutSessionId   String?              @unique
  paymentIntentId     String?              @unique
  paymentStatus       InvoicePaymentStatus @default(DRAFT)
  paymentUrl          String?
  amountCents         Int?
  amountPaidCents     Int?
  currency            String?
  providerMetadataJson Json?
  paidAt              DateTime?
  expiresAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([workspaceId, paymentStatus, createdAt])
  @@index([invoiceId, createdAt])
}

model SmsMessage {
  id                     String           @id @default(cuid())
  workspaceId            String
  workspace              Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matterId               String?
  matter                 Matter?          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  clientId               String?
  client                 Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId                 String?
  user                   User?            @relation("SmsActor", fields: [userId], references: [id], onDelete: SetNull)
  provider               String
  recipientEncrypted     String?
  recipientHash          String?
  recipientLast4         String?
  templateKey            String?
  messagePreviewRedacted String?
  status                 SmsStatus        @default(DRAFT)
  providerMessageId      String?
  sentAt                 DateTime?
  failedAt               DateTime?
  lastError              String?
  consentStatus          SmsConsentStatus @default(UNKNOWN)
  providerMetadataJson   Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  events                 SmsEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([matterId, createdAt])
  @@index([clientId, createdAt])
}

model SmsEvent {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smsMessageId  String?
  smsMessage    SmsMessage? @relation(fields: [smsMessageId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?       @relation("SmsEventActor", fields: [userId], references: [id], onDelete: SetNull)
  eventType     String
  status        SmsStatus
  summary       String?
  metadataJson  Json?
  createdAt     DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model SmsConsent {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedByUserId  String?
  recordedByUser    User?            @relation("SmsConsentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  consentStatus     SmsConsentStatus @default(UNKNOWN)
  source            String?
  notesRedacted     String?
  consentRecordedAt DateTime?
  optOutAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, clientId])
  @@index([workspaceId, consentStatus])
}

model SmsOptOut {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedByUserId String?
  recordedByUser   User?     @relation("SmsOptOutRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  reason           String?
  createdAt        DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([clientId, createdAt])
}

model CloudDriveExportJob {
  id                  String                 @id @default(cuid())
  workspaceId         String
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matterId            String
  matter              Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  provider            String
  exportType          String
  exportStatus        CloudDriveExportStatus @default(STARTED)
  exportedByUserId    String
  exportedByUser      User                   @relation("CloudDriveExportActor", fields: [exportedByUserId], references: [id], onDelete: Cascade)
  providerFolderId    String?
  rootFolderId        String?
  selectedFolderId    String?
  redactedManifestJson Json?
  lastError           String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  items               CloudDriveExportItem[]
  events              CloudDriveEvent[]

  @@index([workspaceId, createdAt])
  @@index([matterId, createdAt])
  @@index([workspaceId, exportStatus, createdAt])
}

model CloudDriveExportItem {
  id               String             @id @default(cuid())
  exportJobId      String
  exportJob        CloudDriveExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerFolderId String?
  providerFileId   String?
  fileName         String
  fileCategory     String
  fileSize         Int?
  createdAt        DateTime           @default(now())

  @@index([exportJobId, createdAt])
  @@index([workspaceId, createdAt])
}

model CloudDriveEvent {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exportJobId   String?
  exportJob     CloudDriveExportJob?   @relation(fields: [exportJobId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?                  @relation("CloudDriveEventActor", fields: [userId], references: [id], onDelete: SetNull)
  eventType     String
  status        CloudDriveExportStatus @default(STARTED)
  summary       String?
  metadataJson  Json?
  createdAt     DateTime               @default(now())

  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}
