generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspacePlan {
  STARTER
  GROWTH
  PRO
}

enum UserRole {
  ADMIN
  AGENT
  REVIEWER
  OPS
  COMPANY_OWNER
  COMPANY_ADMIN
  ORGANISATION_ACCESS_ADMIN
  PRINCIPAL_REGISTERED_MIGRATION_AGENT
  SENIOR_MIGRATION_AGENT
  MIGRATION_AGENT
  CASE_MANAGER
  ADMIN_ASSISTANT
  CLIENT_REVIEW_COORDINATOR
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserVisibilityScope {
  ASSIGNED_ONLY
  TEAM_OVERSIGHT
  FIRM_WIDE
}

enum MatterStatus {
  IN_PROGRESS
  AWAITING_DOCS
  READY_FOR_REVIEW
  DRAFT
}

enum MatterStage {
  INTAKE
  EVIDENCE
  FIELD_REVIEW
  VALIDATION
  SUBMISSION_PREP
}

enum ExtractionStatus {
  QUEUED
  EXTRACTED
  NEEDS_REVIEW
}

enum ReviewStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum FieldStatus {
  HIGH_CONFIDENCE
  SUPPORTED
  NEEDS_REVIEW
  CONFLICTING
  MISSING
  VERIFIED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResolutionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum ImpactStatus {
  NEW
  REVIEWING
  ACTIONED
  DISMISSED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IntakeRequestStatus {
  DRAFT
  SENT
  VIEWED
  SUBMITTED
  REVIEWED
}

enum DocumentRequestStatus {
  DRAFT
  SENT
  VIEWED
  COMPLETED
  OVERDUE
}

enum DocumentRequestItemStatus {
  MISSING
  REQUESTED
  RECEIVED
  REVIEWED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentSyncStatus {
  NOT_CONFIGURED
  NEEDS_CONNECTION
  DRY_RUN_READY
  SYNCED
  CANCELLED
  FAILED
}

enum EmailSyncStatus {
  NOT_CONFIGURED
  NEEDS_CONNECTION
  DRY_RUN_READY
  LINKED
  CONTENT_IMPORTED
  SENT
  FAILED
  DISCONNECTED
}

enum EsignStatus {
  DRAFT
  SENT
  VIEWED
  SUBMITTED
  REVOKED
  EXPIRED
  FAILED
}

enum AcknowledgementReviewStatus {
  AGENT_REVIEW_REQUIRED
  REVIEWED
  FLAGGED
}

enum GeneratedDocumentType {
  COVER_LETTER
  STATUTORY_DECLARATION_TEMPLATE
  DOCUMENT_REQUEST_CHECKLIST
  SKILLS_ASSESSMENT_CHECKLIST
  SPONSORSHIP_CHECKLIST
  CHARACTER_REFERENCE_TEMPLATE
  GENUINE_STUDENT_STATEMENT_OUTLINE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  OVERDUE
}

enum BillingPlan {
  STARTER
  PRO
  TEAM
}

enum WorkspaceSubscriptionStatus {
  NOT_CONFIGURED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum InvoicePaymentStatus {
  NOT_CONFIGURED
  DISABLED
  DRAFT
  OPEN
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum SmsStatus {
  DRAFT
  DRY_RUN
  SENT
  FAILED
  BLOCKED_NO_CONSENT
  BLOCKED_RATE_LIMITED
  NOT_CONFIGURED
  OPTED_OUT
}

enum SmsConsentStatus {
  UNKNOWN
  CONSENTED
  OPTED_OUT
  INTERNAL_ONLY
}

enum CloudDriveExportStatus {
  STARTED
  DRY_RUN
  COMPLETED
  FAILED
}

enum InvoiceAssetKind {
  LOGO
  SIGNATURE
  TEMPLATE
  ATTACHMENT
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AssistantContextType {
  WORKSPACE
  MATTER
  CLIENT
  DOCUMENT
  INVOICE
  UPDATE
}

enum AssistantThreadStatus {
  ACTIVE
  ARCHIVED
}

enum AssistantRunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MigrationIntelSourceType {
  OFFICIAL
  NEWS
  FIRM_NOTE
  AI_SUMMARY
}

enum MigrationIntelSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MigrationIntelSweepStatus {
  STARTED
  COMPLETED
  FAILED
}

enum TemplateValueType {
  TEXT
  DATE
  NUMBER
  BOOLEAN
  CURRENCY
  SELECT
  MULTI_SELECT
}

enum DraftStatus {
  DRAFTING
  READY_FOR_AGENT_REVIEW
  AGENT_REVIEWED
  READY_FOR_CLIENT_REVIEW
  SENT_TO_CLIENT
  CLIENT_CONFIRMED
  RETURNED_TO_AGENT
  NEEDS_WORK
}

enum DraftFieldStatus {
  HIGH_CONFIDENCE
  SUPPORTED
  NEEDS_REVIEW
  CONFLICTING
  MISSING
  VERIFIED
}

enum ReviewRequestStatus {
  REVIEW_REQUESTED
  SENT_TO_CLIENT
  VIEWED_BY_CLIENT
  SIGNED_CONFIRMED
  RETURNED_TO_AGENT
  REQUIRES_FOLLOW_UP
}

enum OfficialFormLifecycleStatus {
  CURRENT
  NEEDS_REVIEW
  SUPERSEDED
  UNKNOWN
}

enum OfficialFormSupportStatus {
  ONLINE_ONLY
  MANUAL_ONLY
  FILLABLE_PDF
  MAPPING_REQUIRED
  NEEDS_REVIEW
  SUPERSEDED
  UNKNOWN
}

enum RegistryRecordStatus {
  ACTIVE
  CLOSED
  SUPERSEDED
  UNKNOWN
  NEEDS_REVIEW
}

enum RegistrySupportLevel {
  FULL_FIELD_AUTOFILL
  DRAFT_TEMPLATE
  CHECKLIST_ONLY
  SCAFFOLD_ONLY
  NEEDS_REVIEW
}

enum MatterOfficialFormDraftStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  PUBLISHED
  UNSUPPORTED
}

model Workspace {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  plan                  WorkspacePlan
  legalName             String?
  businessType          String?
  registrationNumber    String?
  contactEmail          String?
  contactPhone          String?
  website               String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?
  timezone              String                 @default("Australia/Sydney")
  logoUrl               String?
  brandColor            String?
  stripeCustomerId      String?                @unique
  stripeSubscriptionId  String?                @unique
  billingPlan           BillingPlan?
  subscriptionStatus    WorkspaceSubscriptionStatus @default(NOT_CONFIGURED)
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  billingEmail          String?
  billingProvider       String?
  createdAt             DateTime               @default(now())
  users                 User[]
  clients               Client[]
  matters               Matter[]
  documents             Document[]
  tasks                 Task[]
  aiThreads             AiChatThread[]
  aiMessages            AiChatMessage[]
  assistantRuns         AssistantRun[]
  auditEvents           AuditEvent[]
  visaSubclassTemplates VisaSubclassTemplate[]
  visaKnowledgeRecords  VisaKnowledgeRecord[]
  officialSources       OfficialSource[]
  migrationIntelItems   OfficialUpdate[]      @relation("WorkspaceIntelItems")
  migrationIntelSweeps  MigrationIntelSweep[]
  pathwayAnalyses       PathwayAnalysis[]
  intakeRequests        ClientIntakeRequest[]
  documentRequests      DocumentRequest[]
  appointments          Appointment[]
  appointmentSyncEvents CalendarSyncEvent[]
  matterEmailThreads    MatterEmailThread[]
  matterEmailMessages   MatterEmailMessage[]
  emailSyncEvents       EmailSyncEvent[]
  acknowledgementRequests ClientAcknowledgementRequest[]
  acknowledgementResponses ClientAcknowledgementResponse[]
  acknowledgementRecords AcknowledgementRecord[]
  esignEvents           EsignEvent[]
  generatedDocuments    GeneratedDocument[]
  portalAccessTokens    ClientPortalAccessToken[]
  timelineEvents        MatterTimelineEvent[]
  knowledgeEmbeddings   KnowledgeEmbedding[]
  invoiceBranding       InvoiceBranding?
  invoiceTemplates      InvoiceTemplate[]
  invoiceServices       InvoiceService[]
  invoices              Invoice[]
  invoiceAssets         InvoiceAsset[]
  subscriptions         WorkspaceSubscription[]
  billingEvents         BillingEvent[]
  invoicePaymentLinks   InvoicePaymentLink[]
  smsMessages           SmsMessage[]
  smsEvents             SmsEvent[]
  smsConsents           SmsConsent[]
  smsOptOuts            SmsOptOut[]
  cloudDriveExportJobs  CloudDriveExportJob[]
  cloudDriveExportItems CloudDriveExportItem[]
  cloudDriveEvents      CloudDriveEvent[]
  securityIncidents     SecurityIncident[]
  operationalSettings   WorkspaceOperationalSettings?
  officialFormTemplates OfficialFormTemplate[]
  officialFormDrafts    MatterOfficialFormDraft[]
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  hashedPassword    String?
  role              UserRole
  status            UserStatus          @default(ACTIVE)
  jobTitle          String?
  notes             String?
  permissionsJson   Json?
  visibilityScope   UserVisibilityScope @default(ASSIGNED_ONLY)
  invitedAt         DateTime?
  inviteTokenHash   String?             @unique
  inviteExpiresAt   DateTime?
  inviteAcceptedAt  DateTime?
  lastActiveAt      DateTime?
  deactivatedAt     DateTime?
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id])
  supervisorId      String?
  supervisor        User?               @relation("UserSupervisor", fields: [supervisorId], references: [id])
  supervisedUsers   User[]              @relation("UserSupervisor")
  mattersAssigned   Matter[]            @relation("MatterAssignee")
  clientsAssigned   Client[]            @relation("ClientAssignee")
  uploadedDocuments Document[]          @relation("DocumentUploader")
  tasksAssigned     Task[]              @relation("TaskAssignee")
  createdThreads    AiChatThread[]      @relation("ThreadCreator")
  assistantMessages AiChatMessage[]     @relation("AssistantMessageUser")
  assistantRuns     AssistantRun[]
  auditEvents       AuditEvent[]
  reviewedIntelItems   OfficialUpdate[] @relation("IntelReviewedBy")
  reviewedIntelImpacts MatterImpact[]   @relation("IntelImpactReviewedBy")
  pathwayAnalyses   PathwayAnalysis[]
  intakeRequests    ClientIntakeRequest[] @relation("IntakeRequestCreator")
  documentRequests  DocumentRequest[]     @relation("DocumentRequestCreator")
  appointments      Appointment[]         @relation("AppointmentAssignee")
  calendarSyncEvents CalendarSyncEvent[]  @relation("CalendarSyncActor")
  linkedMatterEmailThreads MatterEmailThread[] @relation("MatterEmailThreadLinkedBy")
  emailSyncEvents   EmailSyncEvent[]      @relation("EmailSyncActor")
  acknowledgementRequests ClientAcknowledgementRequest[] @relation("AcknowledgementRequestedBy")
  esignEvents       EsignEvent[]          @relation("EsignActor")
  generatedDocuments GeneratedDocument[]
  timelineEvents    MatterTimelineEvent[] @relation("TimelineActor")
  invoicesCreated   Invoice[]             @relation("InvoiceCreator")
  invoiceTemplatesCreated InvoiceTemplate[] @relation("InvoiceTemplateCreator")
  securityIncidents     SecurityIncident[]
  createdPortalTokens   ClientPortalAccessToken[] @relation("PortalTokenCreator")
  approvedFormDrafts    MatterOfficialFormDraft[] @relation("OfficialFormDraftApprover")
  createdOfficialFormTemplates OfficialFormTemplate[] @relation("OfficialFormTemplateCreator")
  createdOfficialFormDrafts MatterOfficialFormDraft[] @relation("OfficialFormDraftCreator")
  smsMessages          SmsMessage[]               @relation("SmsActor")
  smsConsentsRecorded  SmsConsent[]               @relation("SmsConsentRecorder")
  smsOptOutsRecorded   SmsOptOut[]                @relation("SmsOptOutRecorder")
  smsEvents            SmsEvent[]                 @relation("SmsEventActor")
  cloudDriveExportJobs CloudDriveExportJob[]      @relation("CloudDriveExportActor")
  cloudDriveEvents     CloudDriveEvent[]          @relation("CloudDriveEventActor")

  @@index([workspaceId, status])
  @@index([inviteExpiresAt])
}

model Client {
  id               String            @id @default(cuid())
  clientReference  String?           @unique
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  firstName        String
  lastName         String
  dob              DateTime
  nationality      String
  email            String
  phone            String
  notes            String?
  assignedToUserId String?
  assignedToUser   User?             @relation("ClientAssignee", fields: [assignedToUserId], references: [id])
  createdAt        DateTime          @default(now())
  currentVisaStatus String?
  currentVisaExpiry DateTime?
  archivedAt       DateTime?
  matters          Matter[]
  documents        Document[]
  pathwayAnalyses  PathwayAnalysis[]
  intakeRequests   ClientIntakeRequest[]
  documentRequests DocumentRequest[]
  appointments     Appointment[]
  acknowledgementRequests ClientAcknowledgementRequest[]
  acknowledgementResponses ClientAcknowledgementResponse[]
  acknowledgementRecords AcknowledgementRecord[]
  portalAccessTokens ClientPortalAccessToken[]
  invoices         Invoice[]
  matterImpacts    MatterImpact[]
  smsMessages      SmsMessage[]
  smsConsents      SmsConsent[]
  smsOptOuts       SmsOptOut[]
}

model Matter {
  id                  String                   @id @default(cuid())
  matterReference     String?                  @unique
  workspaceId         String
  workspace           Workspace                @relation(fields: [workspaceId], references: [id])
  clientId            String
  client              Client                   @relation(fields: [clientId], references: [id])
  title               String
  visaSubclass        String
  visaStream          String
  status              MatterStatus
  stage               MatterStage
  currentVisaStatus   String?
  currentVisaExpiry   DateTime?
  applicationStatus   String?
  lodgementDate       DateTime?
  expectedNextMilestone String?
  criticalDeadline    DateTime?
  archivedAt          DateTime?
  lodgementTargetDate DateTime?
  assignedToUserId    String
  assignedToUser      User                     @relation("MatterAssignee", fields: [assignedToUserId], references: [id])
  readinessScore      Int
  lastReviewedAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  documents           Document[]
  extractedFields     ExtractedField[]
  validationIssues    ValidationIssue[]
  checklistItems      ChecklistItem[]
  impacts             MatterImpact[]
  tasks               Task[]
  aiThreads           AiChatThread[]
  applicationDrafts   MatterApplicationDraft[]
  reviewRequests      MatterReviewRequest[]
  pathwayAnalyses     PathwayAnalysis[]
  intakeRequests      ClientIntakeRequest[]
  documentRequests    DocumentRequest[]
  appointments        Appointment[]
  acknowledgementRequests ClientAcknowledgementRequest[]
  acknowledgementResponses ClientAcknowledgementResponse[]
  acknowledgementRecords AcknowledgementRecord[]
  esignEvents         EsignEvent[]
  matterEmailThreads  MatterEmailThread[]
  matterEmailMessages MatterEmailMessage[]
  emailSyncEvents     EmailSyncEvent[]
  smsMessages         SmsMessage[]
  generatedDocuments  GeneratedDocument[]
  portalAccessTokens  ClientPortalAccessToken[]
  timelineEvents      MatterTimelineEvent[]
  invoices            Invoice[]
  officialFormDrafts  MatterOfficialFormDraft[]
  cloudDriveExportJobs CloudDriveExportJob[]
}

model PathwayAnalysis {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId  String
  createdByUser    User            @relation(fields: [createdByUserId], references: [id])
  clientId         String?
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matterId         String?
  matter           Matter?         @relation(fields: [matterId], references: [id], onDelete: SetNull)
  title            String
  profileJson      Json
  summary          String
  assumptionsJson  Json
  blockersJson     Json
  evidenceGapsJson Json
  reviewNotes      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  options          PathwayOption[]

  @@index([workspaceId, createdAt])
  @@index([matterId])
}

model PathwayOption {
  id              String          @id @default(cuid())
  analysisId      String
  analysis        PathwayAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  rank            Int
  pathwayType     String
  title           String
  relevance       String
  confidence      Float
  conditionsJson  Json
  missingJson     Json
  risksJson       Json
  nextActionsJson Json
  createdAt       DateTime        @default(now())
}

model Document {
  id                 String                         @id @default(cuid())
  workspaceId        String
  workspace          Workspace                      @relation(fields: [workspaceId], references: [id])
  clientId           String
  client             Client                         @relation(fields: [clientId], references: [id])
  matterId           String
  matter             Matter                         @relation(fields: [matterId], references: [id])
  fileName           String
  storageKey         String
  mimeType           String
  fileSize           Int?
  contentHash        String?
  category           String
  subcategory        String?
  uploadedByUserId   String
  uploadedByUser     User                           @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  extractionStatus   ExtractionStatus
  reviewStatus       ReviewStatus
  createdAt          DateTime                       @default(now())
  extractedFields    ExtractedField[]
  draftEvidenceLinks MatterDraftFieldEvidenceLink[]
  extractionResults  DocumentExtractionResult[]
  storageObject      DocumentStorageObject?
  checklistItems     ChecklistItem[]
}

model DocumentStorageObject {
  id         String   @id @default(cuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider   String
  storageKey String
  data       Bytes?
  createdAt  DateTime @default(now())
}

model ExtractedField {
  id            String      @id @default(cuid())
  matterId      String
  matter        Matter      @relation(fields: [matterId], references: [id])
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id])
  fieldKey      String
  fieldLabel    String
  fieldValue    String
  confidence    Float
  sourceSnippet String
  sourcePageRef String
  status        FieldStatus
  needsReview   Boolean
  createdAt     DateTime    @default(now())
}

model ValidationIssue {
  id               String           @id @default(cuid())
  matterId         String
  matter           Matter           @relation(fields: [matterId], references: [id])
  severity         IssueSeverity
  type             String
  title            String
  description      String
  relatedFieldKey  String?
  resolutionStatus ResolutionStatus
  createdAt        DateTime         @default(now())
}

model ChecklistItem {
  id       String  @id @default(cuid())
  matterId String
  matter   Matter  @relation(fields: [matterId], references: [id])
  documentId String?
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  itemKey   String?
  category String
  label    String
  description String?
  status   String
  required Boolean
  notes    String?
  dueDate  DateTime?
  requestedAt DateTime?
  reviewedAt DateTime?
  requestItems DocumentRequestItem[]
}

model VisaSubclassTemplate {
  id             String                      @id @default(cuid())
  workspaceId    String?
  workspace      Workspace?                  @relation(fields: [workspaceId], references: [id])
  subclassCode   String
  stream         String?
  name           String
  description    String
  version        String
  active         Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  sections       VisaTemplateSection[]
  fields         VisaTemplateField[]
  requirements   VisaTemplateRequirement[]
  checklistItems VisaTemplateChecklistItem[]
  drafts         MatterApplicationDraft[]

  @@unique([workspaceId, subclassCode, stream, version])
  @@index([subclassCode, stream, active])
}

model VisaKnowledgeRecord {
  id                  String     @id @default(cuid())
  workspaceId         String?
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subclassCode        String?
  stream              String?
  title               String
  summary             String
  keyRequirementsJson Json
  evidenceJson        Json
  sourceUrl           String
  sourceType          String
  contentHash         String
  lastRefreshedAt     DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([sourceUrl, contentHash])
  @@index([workspaceId])
  @@index([subclassCode, stream])
  @@index([lastRefreshedAt])
}

model VisaTemplateSection {
  id          String               @id @default(cuid())
  templateId  String
  template    VisaSubclassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String?
  sortOrder   Int
  fields      VisaTemplateField[]

  @@unique([templateId, key])
}

model VisaTemplateField {
  id                          String               @id @default(cuid())
  templateId                  String
  template                    VisaSubclassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId                   String
  section                     VisaTemplateSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  fieldKey                    String
  label                       String
  helpText                    String?
  valueType                   TemplateValueType
  required                    Boolean              @default(false)
  supportedDocumentCategories String[]
  validationRules             Json?
  sortOrder                   Int
  draftFields                 MatterDraftField[]

  @@unique([templateId, fieldKey])
}

model VisaTemplateRequirement {
  id           String               @id @default(cuid())
  templateId   String
  template     VisaSubclassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category     String
  label        String
  description  String
  required     Boolean              @default(true)
  ruleKey      String
  metadataJson Json?

  @@unique([templateId, ruleKey])
}

model VisaTemplateChecklistItem {
  id           String               @id @default(cuid())
  templateId   String
  template     VisaSubclassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category     String
  label        String
  required     Boolean              @default(true)
  sortOrder    Int
  metadataJson Json?
}

model MatterApplicationDraft {
  id             String                @id @default(cuid())
  matterId       String
  matter         Matter                @relation(fields: [matterId], references: [id], onDelete: Cascade)
  templateId     String
  template       VisaSubclassTemplate  @relation(fields: [templateId], references: [id])
  status         DraftStatus           @default(DRAFTING)
  readinessScore Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  fields         MatterDraftField[]
  reviewRequests MatterReviewRequest[]

  @@unique([matterId, templateId])
}

model MatterDraftField {
  id              String                         @id @default(cuid())
  draftId         String
  draft           MatterApplicationDraft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  templateFieldId String
  templateField   VisaTemplateField              @relation(fields: [templateFieldId], references: [id])
  value           String?
  confidence      Float?
  sourceSnippet   String?
  sourcePageRef   String?
  status          DraftFieldStatus               @default(MISSING)
  reviewedAt      DateTime?
  verifiedAt      DateTime?
  manualOverride  String?
  notes           String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  evidenceLinks   MatterDraftFieldEvidenceLink[]

  @@unique([draftId, templateFieldId])
}

model MatterDraftFieldEvidenceLink {
  id            String           @id @default(cuid())
  draftFieldId  String
  draftField    MatterDraftField @relation(fields: [draftFieldId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceSnippet String?
  sourcePageRef String?
  confidence    Float?
  createdAt     DateTime         @default(now())
}

model DocumentExtractionResult {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  provider      String
  model         String?
  extractedJson Json
  createdAt     DateTime @default(now())
}

model MatterReviewRequest {
  id             String                 @id @default(cuid())
  matterId       String
  matter         Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  draftId        String
  draft          MatterApplicationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  status         ReviewRequestStatus    @default(REVIEW_REQUESTED)
  recipientEmail String?
  recipientName  String?
  message        String?
  publicToken    String?                @unique
  publicTokenHash String?               @unique
  publicTokenPreview String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  confirmedAt    DateTime?
  returnedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ClientAcknowledgementRequest {
  id                   String                      @id @default(cuid())
  workspaceId          String
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matterId             String
  matter               Matter                      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedByUserId    String
